PORT=8080

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/uifive
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=0
DB_POOL_MAX_LIFETIME_MS=900000
DB_POOL_IDLE_TIMEOUT_MS=600000
DB_POOL_KEEPALIVE_TIME_MS=300000
DB_POOL_VALIDATION_TIMEOUT_MS=5000
DB_POOL_CONNECTION_TIMEOUT_MS=20000

# JWT Configuration
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=3600000

# Resend API
RESEND_API_KEY=your_resend_api_key
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=UIFive <no-reply@example.com>

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# API GEMINI
GEMINI_API_KEY=your_gemini_api_key

# NVIDIA API
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# OpenAI / ChatGPT
OPENAI_API_KEY=your_openai_api_key

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cloudinary config
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Payment config
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
PAYMENT_VNPAY_TMN_CODE=your_vnpay_tmn_code
PAYMENT_VNPAY_SECRET=your_vnpay_secret
PAYMENT_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
PAYMENT_BANK_BIN=970422
PAYMENT_BANK_QR_BASE_URL=https://img.vietqr.io/image
PAYMENT_BANK_ACCOUNT_NUMBER=0000000000
PAYMENT_BANK_SECRET=change-me-bank-secret
PAYMENT_MOMO_ENABLED=false
PAYMENT_MOMO_PAY_URL=https://test-payment.momo.vn/mock
PAYMENT_MOMO_SECRET=your_momo_secret
PAYMENT_MOCK_CONFIRM_ENABLED=false

# ML service deployed URL
ML_API_URL=http://localhost:8000/predict
ML_TIMEOUT_MS=15000
ML_CONNECT_TIMEOUT_MS=3000
ML_READ_TIMEOUT_MS=15000

NOTIFICATION_TIME_ZONE=Asia/Ho_Chi_Minh
NOTIFICATION_VIP_REMINDER_CRON=0 55 17 * * *
NOTIFICATION_VIP_REMINDER_DAYS_BEFORE=3
NOTIFICATION_STREAK_REMINDER_CRON=0 02 18 * * *
NOTIFICATION_STREAK_RESET_CRON=0 5 0 * * *

USER_DEFAULT_AVATAR_BASE_URL=https://api.dicebear.com/7.x/avataaars/svg?seed=
USER_DEFAULT_BACKGROUND_URL=https://images.unsplash.com/photo-1522542550221-31fd19575a2d?auto=format&fit=crop&w=1600&q=80

# Frontend URL used for OAuth redirects and CORS
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public backend URL used when generating verification links
BACKEND_PUBLIC_BASE_URL=http://localhost:8080

UPSTASH_REDIS_URL=rediss://default:your_upstash_password@your-upstash-host:6379

# Optional app/security settings
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
MAIL_FROM_EMAIL=
