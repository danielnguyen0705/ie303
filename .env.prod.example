# Docker image namespace and version
DOCKER_NAMESPACE=yourname
IMAGE_TAG=1.0

# Shared backend values
DB_URL=jdbc:postgresql://ep-still-pine-a1nt4j1f-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&prepareThreshold=0
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=86400000

# Redis
REDIS_URL=rediss://default:change-me@your-upstash-host:6379

# Public URLs
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:3000

# RabbitMQ / CloudAMQP
CLOUDAMQP_URL=amqps://your-cloudamqp-username:your-cloudamqp-password@your-cloudamqp-host/your-cloudamqp-vhost

# App service URLs used by the backend
NOTIFICATION_SERVICE_BASE_URL=http://notification-service:8082
PROGRESS_SERVICE_BASE_URL=http://progress-service:8087
ML_API_URL=http://ml-service:8000/predict

# Google OAuth
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Notification / email
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=noreply@uifive.local
NOTIFICATION_TIME_ZONE=Asia/Ho_Chi_Minh
NOTIFICATION_VIP_REMINDER_CRON=0 0 9 * * *
NOTIFICATION_VIP_REMINDER_DAYS_BEFORE=3
NOTIFICATION_STREAK_REMINDER_CRON=0 0 9 * * *
NOTIFICATION_STREAK_RESET_CRON=0 5 0 * * *

# Payment
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_MOCK_CONFIRM_ENABLED=false
PAYMENT_MOMO_ENABLED=false
PAYMENT_MOMO_SECRET=change-me
PAYMENT_VNPAY_TMN_CODE=change-me
PAYMENT_VNPAY_SECRET=change-me
PAYMENT_BANK_BIN=970415
PAYMENT_BANK_ACCOUNT_NUMBER=0000000000
PAYMENT_BANK_SECRET=change-me

# AI / LLM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
