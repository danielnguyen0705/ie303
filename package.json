{
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1"
  },
  "name": "ie303",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n frontend,backend \"npm run fe\" \"npm run be\"",
    "fe": "cd Frontend && npm run dev",
    "be": "concurrently -n eureka,gateway,identity,payment,notification,gamification,content,progress,ai,ml \"npm run eureka\" \"npm run gateway\" \"npm run identity\" \"npm run payment\" \"npm run notification\" \"npm run gamification\" \"npm run content\" \"npm run progress\" \"npm run ai\" \"npm run ml\"",
    "eureka": "cd EurekaService && mvn spring-boot:run",
    "gateway": "cd GatewayService && mvn spring-boot:run",
    "identity": "cd IdentityService && mvn spring-boot:run",
    "payment": "cd PaymentService && mvn spring-boot:run",
    "notification": "cd NotificationService && mvn spring-boot:run",
    "gamification": "cd GamificationService && mvn spring-boot:run",
    "content": "cd ContentService && mvn spring-boot:run",
    "progress": "cd ProgressService && mvn spring-boot:run",
    "ai": "cd AIService && mvn spring-boot:run",
    "ml": "cd MLService && python app.py",
    "build": "cd Frontend && npm run build",
    "preview": "cd Frontend && npm run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielnguyen0705/ie303.git"
  },
