# Local Docker environment for UIFIVE
# Use with:
#   docker compose --env-file .env.docker up -d

# Shared
DB_URL=jdbc:postgresql://postgres:5432/uifive
DB_USERNAME=postgres
DB_PASSWORD=postgres
JWT_SECRET=change-me-in-docker
JWT_EXPIRATION=86400000
REDIS_URL=redis://redis:6379

# Public URLs inside Docker/local
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_PUBLIC_BASE_URL=http://localhost:8081

# Gateway / service URLs
IDENTITY_SERVICE_BASE_URL=http://identity-service:8084
PAYMENT_SERVICE_BASE_URL=http://payment-service:8083
PROGRESS_SERVICE_BASE_URL=http://progress-service:8087
CONTENT_SERVICE_BASE_URL=http://content-service:8086
GAMIFICATION_SERVICE_BASE_URL=http://gamification-service:8085
AI_SERVICE_BASE_URL=http://ai-service:8088
NOTIFICATION_SERVICE_BASE_URL=http://notification-service:8082
ML_API_URL=http://ml-service:8000/predict

# CORS / cookie
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
CLOUDAMQP_URL=amqp://guest:guest@rabbitmq:5672/%2F

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notification / email
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@uifive.local
NOTIFICATION_TIME_ZONE=Asia/Ho_Chi_Minh
NOTIFICATION_VIP_REMINDER_CRON=0 0 9 * * *
NOTIFICATION_VIP_REMINDER_DAYS_BEFORE=3
NOTIFICATION_STREAK_REMINDER_CRON=0 0 9 * * *
NOTIFICATION_STREAK_RESET_CRON=0 5 0 * * *

# Cloudinary
CLOUD_NAME=
API_KEY=
API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI / LLM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Payment
PAYMENT_WEBHOOK_SECRET=
PAYMENT_MOCK_CONFIRM_ENABLED=true
PAYMENT_MOMO_ENABLED=false
PAYMENT_MOMO_SECRET=
PAYMENT_VNPAY_TMN_CODE=
PAYMENT_VNPAY_SECRET=
PAYMENT_BANK_BIN=970415
PAYMENT_BANK_ACCOUNT_NUMBER=0000000000
PAYMENT_BANK_SECRET=

# UI/runtime ports
PORT=8081
